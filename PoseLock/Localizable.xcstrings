    "Tu shootes, tu regardes, tu recommences. L’angle qui rendait la semaine dernière, tu ne sais plus lequel c’était." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You shoot, you check, you start over. The angle that worked last week? You can’t remember which one it was."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disparas, miras, repites. El ángulo que funcionaba la semana pasada, ya no sabes cuál era."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du shootest, schaust, fängst von vorne an. Welcher Winkel letzte Woche gewirkt hat, weißt du nicht mehr."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você fotografa, confere, recomeça. O ângulo que funcionava na semana passada, você nem lembra qual era."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu shootes, tu regardes, tu recommences. L’angle qui rendait la semaine dernière, tu ne sais plus lequel c’était."
          }
        }
      }
    },
    "Tu tiens la pose ou tu la perds, et tu ne l’apprends qu’en voyant les photos, une semaine plus tard." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You hold the pose or lose it, and you only find out from the photos, a week later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantienes la pose o la pierdes, y solo lo sabes al ver las fotos, una semana después."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hältst die Pose oder verlierst sie – und erfährst es erst eine Woche später auf den Fotos."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você segura a pose ou perde, e só descobre vendo as fotos, uma semana depois."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu tiens la pose ou tu la perds, et tu ne l’apprends qu’en voyant les photos, une semaine plus tard."
          }
        }
      }
    },
