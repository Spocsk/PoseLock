    "Aide-nous à améliorer PoseLock avec quelques événements d’usage sans compte. Aucune image, vidéo, pose ou score n’est envoyé. Tu pourras changer d’avis dans Réglages." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Help us improve PoseLock with a few account-free usage events. No image, video, pose or score is sent. You can change your mind in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayúdanos a mejorar PoseLock con algunos eventos de uso sin cuenta. No se envía ninguna imagen, vídeo, pose ni puntuación. Puedes cambiar de opinión en Ajustes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilf uns, PoseLock mit ein paar Nutzungsereignissen ohne Konto zu verbessern. Es werden keine Bilder, Videos, Posen oder Scores gesendet. Du kannst das in den Einstellungen jederzeit ändern."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajude a melhorar o PoseLock com alguns eventos de uso sem conta. Nenhuma imagem, vídeo, pose ou pontuação é enviada. Você pode mudar de ideia em Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aide-nous à améliorer PoseLock avec quelques événements d’usage sans compte. Aucune image, vidéo, pose ou score n’est envoyé. Tu pourras changer d’avis dans Réglages."
          }
        }
      }
    },
