    "PoseLock lit ta pose image par image et affiche un score en direct. Sans caméra, il n’y a rien à noter." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PoseLock reads your pose frame by frame and shows a live score. Without the camera, there’s nothing to score."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PoseLock lee tu pose fotograma a fotograma y muestra una puntuación en directo. Sin cámara, no hay nada que puntuar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PoseLock liest deine Pose Bild für Bild und zeigt live einen Score. Ohne Kamera gibt es nichts zu bewerten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PoseLock lê sua pose quadro a quadro e mostra uma pontuação ao vivo. Sem câmera, não há nada para avaliar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PoseLock lit ta pose image par image et affiche un score en direct. Sans caméra, il n’y a rien à noter."
          }
        }
      }
    },
    "PoseLock note la pose on-device. Relance l’autorisation pour travailler." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PoseLock scores the pose on-device. Allow the camera again to train."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PoseLock puntúa la pose en el dispositivo. Vuelve a dar permiso para entrenar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PoseLock bewertet die Pose auf dem Gerät. Erlaube die Kamera erneut, um zu trainieren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PoseLock avalia a pose no aparelho. Permita a câmera de novo para treinar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PoseLock note la pose on-device. Relance l’autorisation pour travailler."
          }
        }
      }
    },
